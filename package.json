{
  "name": "o3-car-spa-website",
  "version": "1.0.0",
  "description": "O3 Car-Spa Studio — Premium Car Detailing Website",
  "main": "index.html",
  "scripts": {
    "build": "babel app.jsx -o app.js && tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "predev": "npm run build",
    "dev": "npx http-server . -p 8080 -c-1 -o",
    "prestart": "npm run build",
    "start": "npx http-server . -p 8080 -c-1 -o",
    "serve": "npx serve . -p 8080"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "tailwindcss": "^3.4.17"
  },
  "keywords": [
    "detailing",
    "car-spa",
    "o3",
    "ceramic-coating",
    "ppf"
  ],
  "author": "O3 Car Spa",
  "license": "ISC"
}
